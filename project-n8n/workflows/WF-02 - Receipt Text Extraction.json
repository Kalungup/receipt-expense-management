{
  "name": "WF-02 - Receipt Text Extraction",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "id": "e3a4d7c8-5633-462c-b0d3-50a895046548",
      "name": "Receive Receipt from WF-01"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\n\nconst binary = item.binary ?? {};\nconst binaryKeys = Object.keys(binary);\n\nif (binaryKeys.length === 0) {\n  throw new Error(\n    'No receipt file was received. Binary data is missing.'\n  );\n}\n\nconst receiptKey = binaryKeys[0];\nconst receiptFile = binary[receiptKey];\n\nreturn [\n  {\n    json: {\n      ...item.json,\n\n      receipt_binary_property: receiptKey,\n\n      receipt_file_name: receiptFile.fileName ?? null,\n\n      receipt_mime_type: receiptFile.mimeType ?? null,\n\n      extraction_status: 'ready_for_extraction'\n    },\n\n    binary: item.binary\n  }\n];;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "a423f4cb-70bc-437a-8123-302935a42423",
      "name": "Inspect Receipt Input"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "01f51114-070b-499d-bb44-6e501a5d080b",
              "leftValue": "={{ ['image/jpeg', 'image/png', 'application/pdf'].includes($json.receipt_mime_type) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "e44dedb8-035e-4c76-8e5b-6db0d10b0b6d",
              "leftValue": "={{ $json.extraction_status === 'ready_for_extraction' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        416,
